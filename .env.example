# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare Turnstile (captcha on auth flows)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Feedback widget (Resend)
# RESEND_API_KEY: provision via the Resend↔Vercel Marketplace integration.
#   If unset, the /api/feedback endpoint returns 503 and the widget shows a
#   "no disponible" message — local dev is not blocked.
RESEND_API_KEY=
# FEEDBACK_FROM_EMAIL: defaults to Resend's sandbox sender (onboarding@resend.dev)
#   during the private beta. Switch to feedback@<your-domain> once a custom
#   domain is verified in Resend (the app is on *.vercel.app today, which cannot
#   be verified for sending).
FEEDBACK_FROM_EMAIL=onboarding@resend.dev
# FEEDBACK_TO_EMAIL: where feedback emails are delivered.
FEEDBACK_TO_EMAIL=lauragargar+feedbackVolleyScore@gmail.com
